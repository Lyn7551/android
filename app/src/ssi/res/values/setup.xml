<!-- SSI Cloud branded overlay: overrides selected branding keys from main setup.xml -->
<resources>
    <!-- App name and other strings -->
    <string name="app_name">SSI Cloud</string>
    <string name="default_display_name_for_root_folder">SSI Cloud</string>
    <string name="name_for_branded_user_agent">SSI Cloud</string>
    <string name="nextcloud_user_agent">Mozilla/5.0 (Android) SSICloud-android/%1$s%2$s</string>

    <!-- Branding flags -->
    <bool name="is_branded_client">true</bool>
    <bool name="show_whats_new">false</bool>
    <bool name="show_provider_or_own_installation">false</bool>
    <bool name="participate_enabled">false</bool>

    <!-- Enforced server list: login shows a server spinner instead of the free-input URL field.
         Replace the URL with the production domain once it is final. Double quotes must be
         escaped, otherwise aapt strips them and the JSON becomes unparseable at runtime. -->
    <string name="enforce_servers" translatable="false">[{\"name\":\"SSI Cloud\",\"url\":\"http://172.19.126.65:30000\"}]</string>

    <!-- Splash screen brand subtitle, rendered as "SSI Cloud" -->
    <string name="splashScreenBold">SSI</string>
    <string name="splashScreenNormal">Cloud</string>

    <!-- Colors -->
    <color name="primary">#0F766E</color>
    <color name="primary_dark">#0B5C56</color>
    <color name="color_accent">#0F766E</color>
    <color name="login_text_hint_color">#A9DBD5</color>

    <!-- Help, privacy and recommend -->
    <bool name="help_enabled">false</bool>
    <bool name="privacy_enabled">false</bool>
    <bool name="recommend_enabled">false</bool>

    <!-- Source code: point to the SSI fork (AGPL source offer) -->
    <string name="sourcecode_url" translatable="false">https://github.com/Lyn7551/android</string>
</resources>
